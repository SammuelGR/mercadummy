# HTTP server
PORT=3000

# Exact front-end origin allowed by CORS and by the Origin check on writes
FRONTEND_ORIGIN=http://localhost:5173

# Secure attribute of the session cookie; set to false only locally without HTTPS
COOKIE_SECURE=false

# Database connections
POSTGRES_URL=postgresql://mercadummy:local_password@127.0.0.1:5432/mercadummy
MONGODB_URL=mongodb://127.0.0.1:27017/mercadummy
REDIS_URL=redis://127.0.0.1:6379
